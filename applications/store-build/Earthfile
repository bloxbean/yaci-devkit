VERSION 0.8

store-native:
  LOCALLY
  ARG STORE_BRANCH
  ARG APP_VERSION

  WORKDIR .
  RUN rm -rf tmp
  RUN mkdir tmp
  WORKDIR tmp
  RUN git clone --depth 1 --branch ${STORE_BRANCH} https://github.com/bloxbean/yaci-store.git yaci-store

  RUN git --git-dir yaci-store/.git rev-parse --short HEAD > yaci-store/store.git.properties

  FROM ghcr.io/graalvm/graalvm-community:21

  COPY tmp/yaci-store yaci-store
  COPY store.build.n2c.application.properties store.build.n2c.application.properties
  COPY store.build.all.application.properties store.build.all.application.properties

  WORKDIR yaci-store
  RUN mkdir -p output

  # Build the n2c variant (N2C local-state-query; used for haskell-only/companion/yano-primary)
  RUN cp ../store.build.n2c.application.properties applications/all/src/main/resources/application.properties
  RUN --mount=type=cache,target=/root/.gradle ./gradlew --no-daemon -i -Pversion=${APP_VERSION} -Pprofile=n2c clean nativeCompile
  RUN cp applications/all/build/native/nativeCompile/yaci-store output/yaci-store-n2c

  # Build the all variant (no N2C; derives protocol params via epoch-aggr; used for yano-only)
  RUN cp ../store.build.all.application.properties applications/all/src/main/resources/application.properties
  RUN --mount=type=cache,target=/root/.gradle ./gradlew --no-daemon -i -Pversion=${APP_VERSION} -Pprofile=all clean nativeCompile
  RUN cp applications/all/build/native/nativeCompile/yaci-store output/yaci-store-all

  # Save artifacts (both native variants + git properties)
  SAVE ARTIFACT output/yaci-store-n2c yaci-store-n2c
  SAVE ARTIFACT output/yaci-store-all yaci-store-all
  SAVE ARTIFACT store.git.properties yaci-store.git.properties
